# -----------------------------------------------------------------
# .env.example · kiro.dev
#
# Copy to .env locally (the real .env is gitignored). CI reads these
# values from GitHub Actions repository *variables* (not secrets),
# unless explicitly marked SECRET.
#
# Do NOT put real credentials here. This file is committed.
# -----------------------------------------------------------------

# Which review runner should .github/workflows/review.yml use?
#   abstain      - default; produces a valid no-op report. Safe for
#                  first-time clones with no agent platform wired up.
#   codex        - routes through `codex review` (Codex CLI). Requires
#                  OPENAI_API_KEY to be set as a repository SECRET.
#   claude-code  - routes through `claude-code review`. Requires
#                  ANTHROPIC_API_KEY as a repository SECRET.
#   custom       - invokes $CUSTOM_REVIEW_CMD (see below).
#
# See templates/review-personas/README.md § 3.1 for the verdict
# semantics that each runner is expected to respect.
REVIEW_RUNNER=abstain

# Optional model override passed through to the runner adapter.
# Examples: gpt-5.1-codex, claude-opus-4.6. Leave blank for default.
REVIEW_MODEL=

# Only used when REVIEW_RUNNER=custom. Must be an absolute command
# that accepts two positional args: (persona_file_path, diff_path)
# and emits a valid raw-YAML review report to stdout (see
# templates/review-personas/README.md § 3.2).
CUSTOM_REVIEW_CMD=
